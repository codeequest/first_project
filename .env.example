# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────────
# Local Postgres via `docker compose up -d`:
DATABASE_URL="postgresql://nexa:nexa@localhost:5433/nexa_academy?schema=public"
# Hosted (Neon, Supabase, Railway…) — use the pooled connection string and
# keep `sslmode=require`:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public base URL of the site. In production set this to your real domain.
AUTH_URL="http://localhost:3000"

# ── Seed ────────────────────────────────────────────────────────────────────
# Credentials for the first admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Used by src/lib/mail.ts. Not wired into any flow yet — see
# src/lib/emails/enrollment.ts for the templates waiting on it.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="replace-me"
# SMTP_PASSWORD="replace-me"
# Defaults to SMTP_USER if unset.
# SMTP_FROM="Nexa Academy <no-reply@example.com>"
